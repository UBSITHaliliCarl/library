@model Member
@{
    ViewData["FullName"] = "Delete a member";
}

<h1 class="mb-3">Delete a member</h1>

<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this member?</p>
    <dl class="row mb-2">
        <dt class="col-4">Full Name</dt>
        <dd class="col-8">@Model.FullName</dd>
        <dt class="col-4">Email</dt>
        <dd class="col-8">@(Model.Email ?? "—")</dd>
        <dt class="col-4">Member Type</dt>
        <dd class="col-8">@(Model.MemberType ?? "—")</dd>
        <dt class="col-4">Join Date</dt>
        <dd class="col-8">@(Model.JoinDate.ToString("yyyy-MM-dd"))</dd>
    </dl>
    <p class="text-muted small">Any loans of this member are deleted with it.</p>

    <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
