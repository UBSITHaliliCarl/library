@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Members</h1>
        <p class="text-muted mb-0">@Model.Count members</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a member</a>
</div>
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Name</th>
            <th>Email</th>
            <th class="text-end">Phone</th>
            <th>Member Type</th>
            <th>Join Date</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td class="text-end">@member.MemberId</td>
                <td>@member.FullName</td>
                <td>@(string.IsNullOrEmpty(member.Email) ? "—" : member.Email)</td>
                <td class="text-end">@(string.IsNullOrEmpty(member.Phone) ? "—" : member.Phone)</td>
                <td>@member.MemberType</td>
                <td>@member.JoinDate</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-primary">Loans</a>
                    <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
