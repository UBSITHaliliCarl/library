@model Note
@{
    ViewData["Title"] = "Delete a note";
}

<h1 class="mb-3">Delete a note</h1>
<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this note?</p>
    <dl class="row mb-2">
        <dt class="col-4">Title</dt>
        <dd class="col-8">@Model.Title</dd>
        
        <dt class="col-4">Body</dt>
        <dd class="col-8">@(string.IsNullOrEmpty(Model.Body) ? "—" : Model.Body)</dd>
        
        <dt class="col-4">Created On</dt>
        <dd class="col-8">@Model.CreatedOn.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post" class="mt-3">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>

</div>