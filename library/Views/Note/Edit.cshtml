@model Note
@{
    ViewData["Title"] = "Edit a note";
}

<h1 class="mb-3">Edit a note</h1>

<form asp-action="Edit" method="post" class="card card-body" style="max-width:36rem">
    <input type="hidden" asp-for="NoteId" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label"></label>
        <textarea asp-for="Body" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CreatedOn" class="form-label"></label>
        <input asp-for="CreatedOn" class="form-control" type="date" />
        <span asp-validation-for="CreatedOn" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>

</form>